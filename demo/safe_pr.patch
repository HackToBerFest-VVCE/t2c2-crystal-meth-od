---
 src/search.ts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/search.ts b/src/search.ts
index 83a1b2c..94d2e3f 100644
--- a/src/search.ts
+++ b/src/search.ts
@@ -10,6 +10,13 @@ export function searchUsers(query: string): User[] {
+    // Sanitize user query before database lookups
+    if (!query || typeof query !== 'string') {
+        return [];
+    }
+    const sanitizedQuery = query.trim().replace(/[^a-zA-Z0-9\s]/g, "");
+    return db.users.find({ name: sanitizedQuery });
 }
